{
  "name": "flex-column-align-end-and-center",
  "viewportWidth": 400,
  "tolerance": 0.5,
  "root": {
    "id": "col",
    "style": {
      "display": "flex",
      "flexDirection": "column",
      "alignItems": "center",
      "gap": 12
    },
    "expected": { "x": 0, "y": 0, "width": 400, "height": 92 },
    "children": [
      {
        "id": "top",
        "style": { "display": "block", "width": 200, "height": 40 },
        "expected": { "x": 100, "y": 0, "width": 200, "height": 40 }
      },
      {
        "id": "bottom",
        "style": { "display": "block", "width": 100, "height": 40, "alignSelf": "flex-end" },
        "expected": { "x": 300, "y": 52, "width": 100, "height": 40 }
      }
    ]
  }
}
